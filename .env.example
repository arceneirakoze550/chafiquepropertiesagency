VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef"
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_DATABASE_ID=""

# Cloudinary Image Storage Configuration
# SERVER-SIDE ONLY - NEVER EXPOSE SECRET ON CLIENT
