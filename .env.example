# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (Netlify / Vite Environment Variables)
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="chafique-property-agency.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="chafique-property-agency"
VITE_FIREBASE_STORAGE_BUCKET="chafique-property-agency.firebasestorage.app"
